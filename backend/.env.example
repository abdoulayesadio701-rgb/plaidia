# ============================================================
# Configuration de l'API Plaid'IA (backend/)
# Copiez ce fichier en backend/.env et renseignez vos clés.
# Ne commitez JAMAIS backend/.env — seul .env.example doit être versionné.
# ============================================================

# --- Anthropic (utilisé par analyse.py et extract.py pour la
# transcription d'images) ----------------------------------------------
# Générez une clé sur https://console.anthropic.com/
# Si cette variable est absente (et qu'aucun apikey.txt n'existe), le
# serveur bascule automatiquement en MODE DÉMO (voir plus bas) : les
# actions les plus démonstratives répondent avec des données préenregistrées
# réalistes plutôt que d'appeler Claude, les autres renvoient une 503 claire.
ANTHROPIC_API_KEY=sk-ant-...

# --- Judilibre — jurisprudence de la Cour de cassation (optionnel) -----
# Portail PISTE : https://piste.gouv.fr — créez une application, activez
# l'API "Judilibre", récupérez le KeyId.
JUDILIBRE_KEY_ID=votre-key-id-judilibre
# sandbox (par défaut) ou production
JUDILIBRE_ENV=sandbox

# --- Légifrance — textes de loi (optionnel) -----------------------------
# Portail PISTE : https://piste.gouv.fr — créez une application, activez
# l'API "Légifrance", récupérez client_id et client_secret (OAuth2
# client_credentials).
LEGIFRANCE_CLIENT_ID=votre-client-id
LEGIFRANCE_CLIENT_SECRET=votre-client-secret
# sandbox (par défaut) ou production
LEGIFRANCE_ENV=sandbox

# --- CORS ----------------------------------------------------------------
# Origines autorisées à appeler cette API, séparées par des virgules.
# Ajoutez ici l'URL de votre front une fois déployé (ex. Vercel/Netlify).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mode démo (déploiement public, portfolio/CV) -----------------------
# true/false — force le mode démo même si ANTHROPIC_API_KEY est configurée
# (utile pour ne jamais consommer la clé du serveur sur un lien public : un
# visiteur peut quand même passer sa propre clé via "Utiliser ma propre clé
# Anthropic", ce qui repasse SES requêtes en mode réel sans rien changer
# pour les autres visiteurs). Laissez vide en développement normal.
DEMO_MODE=false

# true (par défaut dès que DEMO_MODE=true) / false — si true, la base de
# données est ENTIÈREMENT vidée et reconstruite à chaque démarrage du
# serveur avant d'être réensemencée avec le seul dossier fictif de
# démonstration : c'est ce qui rend vraie la mention "données non
# conservées en mode démo" affichée dans l'app sur un déploiement public.
#
# ATTENTION : sur une base contenant des données à conserver, ne JAMAIS
# activer DEMO_MODE sans avoir explicitement mis DEMO_RESET_DB=false, sous
# peine de perte de données IRRÉVERSIBLE au prochain démarrage.
DEMO_RESET_DB=true

# Taille maximale (en caractères) d'un texte libre envoyé par un client
# (conclusions, notes, textes de corpus...) — protection anti-abus simple.
MAX_TEXTE_CARACTERES=50000

# Débit maximal par adresse IP, toutes routes confondues (voir slowapi).
# Syntaxe : "<nombre>/<seconde|minute|hour|day>".
RATE_LIMIT_DEFAUT=60/minute

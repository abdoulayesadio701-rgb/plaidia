# ============================================
# Configuration de l'Agent de Plaidoirie
# ============================================

# API Anthropic (obligatoire) -- toute l'analyse juridique et la génération
# de plaidoirie (agent principal, vérificateur, critique, stratégie
# combative...), plus les étapes de classification (garde-fou d'entrée,
# détection d'intention, notions juridiques, modèle Claude Haiku).
# Générez une clé sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# API NVIDIA NIM (optionnelle) -- fournisseur DeepSeek pour les tâches
# d'extraction et de résumé uniquement (voir analyse.TypeTache). Sans cette
# clé, tout le reste de l'application continue de fonctionner normalement
# sur Claude -- seules /api/greffier/extraction et /api/analyse/resume
# renvoient une 503 explicite (voir backend/app/demo.py::exiger_cle_api_deepseek).
# Générez une clé sur : https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# APIs optionnelles pour recherche juridique
JUDILIBRE_API_KEY=votre-clé-judilibre
LEGIFRANCE_USERNAME=votre-username
LEGIFRANCE_PASSWORD=votre-password

# Configuration du projet
PROJECT_NAME=plaidoirie_agent
DATABASE_PATH=./plaidoirie.db
LOG_LEVEL=INFO

# Mode développement/production
ENVIRONMENT=development
DEBUG=False

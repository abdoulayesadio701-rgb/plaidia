# ============================================
# Configuration de l'Agent de Plaidoirie
# ============================================

# API Anthropic (obligatoire)
# Générez une clé sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# APIs optionnelles pour recherche juridique
JUDILIBRE_API_KEY=votre-clé-judilibre
LEGIFRANCE_USERNAME=votre-username
LEGIFRANCE_PASSWORD=votre-password

# Configuration du projet
PROJECT_NAME=plaidoirie_agent
DATABASE_PATH=./plaidoirie.db
LOG_LEVEL=INFO

# Mode développement/production
ENVIRONMENT=development
DEBUG=False

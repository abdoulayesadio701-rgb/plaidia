# ============================================
# Configuration de l'Agent de Plaidoirie
# ============================================

# API Anthropic (obligatoire) -- garde-fou d'entrée, détection d'intention,
# notions juridiques (étapes de classification, modèle Claude Haiku).
# Générez une clé sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# API DeepSeek (obligatoire) -- agent principal, vérificateur, critique,
# validation finale, stratégie combative, et les autres fonctions de
# génération/extraction substantielles. Sans cette clé (même avec
# ANTHROPIC_API_KEY présente), le mode démo reste actif -- voir
# backend/app/demo.py::mode_demo_serveur.
# Générez une clé sur : https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# APIs optionnelles pour recherche juridique
JUDILIBRE_API_KEY=votre-clé-judilibre
LEGIFRANCE_USERNAME=votre-username
LEGIFRANCE_PASSWORD=votre-password

# Configuration du projet
PROJECT_NAME=plaidoirie_agent
DATABASE_PATH=./plaidoirie.db
LOG_LEVEL=INFO

# Mode développement/production
ENVIRONMENT=development
DEBUG=False

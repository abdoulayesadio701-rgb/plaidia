{
  "name": "plaidia",
  "private": true,
  "version": "1.0.0",
  "description": "Scripts racine : lance le backend FastAPI et le frontend Vite ensemble en développement. Voir README.md pour l'installation complète (venv Python + npm install dans frontend/) avant la première utilisation.",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "concurrently -n backend,frontend -c blue,magenta --success all \"npm:test:backend\" \"npm:test:frontend\"",
    "test:backend": "cd backend && python -m pytest",
    "test:frontend": "cd frontend && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
